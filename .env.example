# Çalışma modu: DRY_RUN | PAPER | LIVE (varsayılan: DRY_RUN)
BOT_MODE=DRY_RUN

# Kill switch dosyası — bu dosya varsa yeni risk alınmaz
KILL_SWITCH_FILE=KILL_SWITCH

# Kalıcı state dizini (Docker'da volume olmalı)
STATE_DIR=state

# Bayat veri eşiği (ms)
STALE_DATA_THRESHOLD_MS=15000

# Venue API anahtarları — YALNIZCA işlem izni, ASLA çekim izni.
# Gerçek değerleri asla repoya koyma.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
