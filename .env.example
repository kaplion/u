# Çalışma modu: DRY_RUN | PAPER | LIVE (varsayılan: DRY_RUN)
BOT_MODE=DRY_RUN

# Venue seçimi: binance | alpaca (varsayılan: binance)
VENUE=binance

# Kill switch dosyası — bu dosya varsa yeni risk alınmaz
KILL_SWITCH_FILE=KILL_SWITCH

# Kalıcı state dizini (Docker'da volume olmalı)
STATE_DIR=state

# Bayat veri eşiği (ms)
STALE_DATA_THRESHOLD_MS=15000

# İzlenecek semboller (virgülle ayrılmış)
SYMBOLS=BTCUSDT

# Periyodik rekonsiliasyon aralığı (ms) — 60000'den büyük verilse de 60sn'ye kırpılır
RECONCILE_INTERVAL_MS=60000

# Heartbeat yazma aralığı (ms) — state dizinindeki heartbeat.json dışarıdan izlenebilir
HEARTBEAT_INTERVAL_MS=10000

# Emir gönderim zaman aşımı (ms) — yanıt gelmezse emir UNKNOWN'a düşer ve sorgulanır
ORDER_TIMEOUT_MS=10000

# Kısmi dolum bekleme süresi (ms) — süre dolunca politika uygulanır (kalanı iptal)
PARTIAL_FILL_TIMEOUT_MS=30000

# Monitoring dashboard (0 = kapalı). Güvenlik için varsayılan host 127.0.0.1.
DASHBOARD_PORT=0
DASHBOARD_HOST=127.0.0.1

# Venue API anahtarları — YALNIZCA işlem izni, ASLA çekim izni.
# Gerçek değerleri asla repoya koyma.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
